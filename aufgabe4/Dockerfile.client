FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY src /app/src

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "math_factory.client", \
     "--rest-host", "data-manager", "--rest-port", "8080", \
     "--rpc-host", "math-factory-gateway", "--rpc-port", "8081", \
     "--ws-host", "data-manager", "--ws-port", "8080", \
     "--terms", "8", "--threshold", "2500"]
